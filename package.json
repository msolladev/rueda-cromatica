{
  "name": "chromatic-wheel",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@12.17.0",
  "devEngines": {
    "runtime": {
      "name": "node",
      "version": "26.13.0",
      "onFail": "download"
    }
  },
  "scripts": {
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "typecheck": "tsc && pnpm -r typecheck",
    "test": "pnpm -r test",
    "build": "pnpm -r build",
    "docs:api": "typedoc"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@types/node": "catalog:",
    "eslint": "10.15.0",
    "eslint-config-prettier": "10.1.8",
    "eslint-plugin-react-hooks": "7.1.1",
    "eslint-plugin-react-refresh": "0.5.7",
    "globals": "17.14.0",
    "jiti": "2.7.0",
    "prettier": "catalog:",
    "typedoc": "0.28.20",
    "typescript": "catalog:",
    "typescript-eslint": "8.72.2"
  }
}
