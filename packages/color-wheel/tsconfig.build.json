{
  "extends": "./tsconfig.ui.json",
  "compilerOptions": {
    "noEmit": false,
    "declaration": true,
    "emitDeclarationOnly": true,
    "rewriteRelativeImportExtensions": true,
    "rootDir": "src",
    "outDir": "dist/types",
    "tsBuildInfoFile": null
  },
  "include": ["src"],
  "exclude": ["src/**/*.test.ts", "src/ui/testing"]
}
