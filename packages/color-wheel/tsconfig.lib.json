{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    // Without the DOM library or the Node types: the calculations cannot use
    // the browser (docs/05 §1). Only `ui` will have its own tsconfig with DOM.
    "lib": ["ES2024"],
    "types": [],
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "resolveJsonModule": true,
    "tsBuildInfoFile": "./node_modules/.tmp/tsconfig.lib.tsbuildinfo"
  },
  "include": ["src"]
}
