{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    // Without the DOM library or the Node types: the calculations cannot use
    // the browser (docs/05 §1). Only `ui` and the entries have the DOM, in
    // tsconfig.ui.json; if a calculation imported them, this would fail.
    "lib": ["ES2024"],
    "types": [],
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "resolveJsonModule": true,
    "tsBuildInfoFile": "./node_modules/.tmp/tsconfig.lib.tsbuildinfo"
  },
  "include": ["src"],
  "exclude": [
    "src/ui",
    "src/index.ts",
    "src/index.umd.ts",
    "src/**/*.browser.test.ts"
  ]
}
