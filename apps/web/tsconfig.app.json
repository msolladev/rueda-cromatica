{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    // The web runs in the browser and, for the prerendering, in Node; its
    // code only uses what both have, plus the DOM inside effects and events.
    "lib": ["ES2024", "DOM", "DOM.Iterable"],
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "jsx": "react-jsx",
    "resolveJsonModule": true,
    "types": ["vite/client", "vite-plugin-pwa/client"],
    // Type checking and lint read the source of the workspace packages, not
    // their dist/ (docs/05 §8.2).
    "customConditions": ["@chromatic-wheel/source"],
    "tsBuildInfoFile": "./node_modules/.tmp/tsconfig.app.tsbuildinfo"
  },
  "include": [
    "src",
    // spectral.js ships no types; color-wheel declares what it uses.
    "../../packages/color-wheel/src/mixing/spectral.d.ts"
  ],
  "exclude": ["src/sw.ts"]
}
