{
  "name": "@chromatic-wheel/api",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "prisma generate && nest build",
    "catalog:load": "prisma generate && nest start --entryFile cli/load-catalog --env-file .env.development",
    "catalog:pack": "node src/cli/pack-catalog.ts",
    "db:down": "docker compose down",
    "db:migrate": "prisma generate && pnpm --env-file=.env.development exec prisma migrate dev",
    "db:reset": "docker compose down --volumes",
    "db:up": "docker compose up --detach --wait",
    "dev": "nest start --watch --env-file .env.development",
    "postinstall": "prisma generate",
    "start": "node dist/main.js",
    "test": "prisma generate && vitest run",
    "typecheck": "prisma generate && tsc"
  },
  "dependencies": {
    "@chromatic-wheel/catalog-builder": "workspace:*",
    "@chromatic-wheel/domain": "workspace:*",
    "@nestjs/common": "12.5.1",
    "@nestjs/core": "12.5.1",
    "@nestjs/platform-express": "12.5.1",
    "@nestjs/swagger": "12.1.2",
    "@prisma/adapter-pg": "7.10.1",
    "@prisma/client": "7.10.1",
    "@scalar/api-reference": "1.81.0",
    "prisma": "7.10.1",
    "reflect-metadata": "0.2.2",
    "rxjs": "7.8.2",
    "zod": "catalog:"
  },
  "devDependencies": {
    "@nestjs/cli": "12.0.13",
    "@nestjs/testing": "12.5.1",
    "@types/express": "5.0.6",
    "@types/node": "catalog:",
    "@types/pg": "8.23.1",
    "@types/supertest": "7.2.1",
    "pg": "8.23.1",
    "supertest": "7.3.2",
    "typescript": "catalog:",
    "vitest": "catalog:"
  }
}
