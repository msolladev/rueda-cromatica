# The local PostgreSQL of compose.yaml (docs/09 §6). Not a secret: it only
# accepts connections from this machine. Production takes its URL from the
# environment's machine.
DATABASE_URL=postgresql://chromatic_wheel:chromatic_wheel@127.0.0.1:5432/chromatic_wheel
# The API reference, at http://localhost:3000/api/v1/reference (docs/09 §5).
REFERENCE_HOSTS=localhost,127.0.0.1
