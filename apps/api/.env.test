# The database of the integration tests (docs/09 §7), next to the development
# one in the PostgreSQL of compose.yaml. The tests drop it and create it again
# on every run. The CI sets its own DATABASE_URL, which takes precedence.
DATABASE_URL=postgresql://chromatic_wheel:chromatic_wheel@127.0.0.1:5432/chromatic_wheel_test
REFERENCE_HOSTS=reference.test
